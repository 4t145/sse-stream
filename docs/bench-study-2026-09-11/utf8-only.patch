+#[inline]
+fn validate_utf8(value: &[u8]) -> Result<&str, Utf8Error> {
+    if value.len() >= 256 {
+        match simdutf8::basic::from_utf8(value) {
+            Ok(text) => Ok(text),
+            Err(_) => std::str::from_utf8(value),
+        }
+    } else {
+        std::str::from_utf8(value)
+    }
+}
