+#[inline]
+fn find_data_line_end(bytes: &[u8]) -> Option<usize> {
+    #[cfg(feature = "memchr")]
+    {
+        const SCALAR_MAX_LEN: usize = 16;
+        if bytes.len() > SCALAR_MAX_LEN {
+            return memchr::memchr2(b'\n', b'\r', bytes);
+        }
+    }
+    bytes.iter().position(|byte| matches!(*byte, b'\n' | b'\r'))
 }
 
